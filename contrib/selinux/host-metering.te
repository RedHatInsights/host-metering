policy_module(host-metering, 1.0.0)

########################################
#
# Declarations
#

type hostmetering_t;
type hostmetering_exec_t;
init_daemon_domain(hostmetering_t, hostmetering_exec_t)

type hostmetering_var_run_t;
files_pid_file(hostmetering_var_run_t)

type hostmetering_unit_file_t;
systemd_unit_file(hostmetering_unit_file_t)

type hostmetering_tmp_t;
files_tmp_file(hostmetering_tmp_t)

########################################
#
# host-metering local policy
#
allow hostmetering_t self:capability { setgid setuid sys_rawio };
allow hostmetering_t self:fifo_file rw_fifo_file_perms;
allow hostmetering_t self:unix_stream_socket create_stream_socket_perms;
allow hostmetering_t self:unix_dgram_socket create_socket_perms;

manage_dirs_pattern(hostmetering_t, hostmetering_var_run_t, hostmetering_var_run_t)
manage_files_pattern(hostmetering_t, hostmetering_var_run_t, hostmetering_var_run_t)
manage_lnk_files_pattern(hostmetering_t, hostmetering_var_run_t, hostmetering_var_run_t)
files_pid_filetrans(hostmetering_t, hostmetering_var_run_t, { dir file lnk_file })

manage_dirs_pattern(hostmetering_t, hostmetering_tmp_t, hostmetering_tmp_t)
manage_files_pattern(hostmetering_t, hostmetering_tmp_t, hostmetering_tmp_t)
files_tmp_filetrans(hostmetering_t, hostmetering_tmp_t, { dir file })

kernel_getattr_proc(hostmetering_t)
kernel_read_network_state(hostmetering_t)
kernel_read_system_state(hostmetering_t)
kernel_read_net_sysctls(hostmetering_t)

auth_read_passwd(hostmetering_t)

corecmd_exec_bin(hostmetering_t)
corecmd_exec_shell(hostmetering_t)

corenet_tcp_connect_http_port(hostmetering_t)
corenet_tcp_connect_squid_port(hostmetering_t)
corenet_tcp_connect_websm_port(hostmetering_t)

dev_list_sysfs(hostmetering_t)
dev_read_raw_memory(hostmetering_t)
dev_read_sysfs(hostmetering_t)

files_list_tmp(hostmetering_t)

init_read_state(hostmetering_t)

libs_exec_ldconfig(hostmetering_t)

optional_policy(`
     sysnet_dns_name_resolve(hostmetering_t)
     sysnet_domtrans_ifconfig(hostmetering_t)
     sysnet_exec_ifconfig(hostmetering_t)
')

optional_policy(`
     dbus_system_bus_client(hostmetering_t)
')

optional_policy(`
     dmidecode_domtrans(hostmetering_t)
')

optional_policy(`
    rhnsd_manage_config(hostmetering_t)
')

optional_policy(`
    gen_require(`
        type rhsmcertd_config_t;
    ')
    manage_files_pattern(hostmetering_t, rhsmcertd_config_t, rhsmcertd_config_t)
    rhsmcertd_manage_lib_files(hostmetering_t)
    rhsmcertd_manage_log(hostmetering_t)
    rhsmcertd_dbus_chat(hostmetering_t)
')

########################################
#
# Rules required once the daemon is started directly by systemd
# (ExecStart=/usr/bin/host-metering daemon) and actually transitions
# into hostmetering_t
#

gen_require(`
    type cert_t;
    type cgroup_t;
')

# The daemon only reads certificates: tls.LoadX509KeyPair reads the
# consumer certificate and key on every notify, subscription-manager
# helpers read the same pair for identity and list the entitlement and
# product directories, and the cert watcher puts an inotify watch on the
# consumer certificate directory. Nothing on these paths creates,
# rewrites, renames or unlinks a certificate - registration and refresh,
# the only operations that write under /etc/pki, are run by
# subscription-manager itself, not by the daemon - so the access is
# read-only and no write-side permission is granted on cert_t.
allow hostmetering_t cert_t:dir { getattr open read search };
allow hostmetering_t cert_t:file { getattr open read };
# The watch permission for directories is not defined in the RHEL 8 base
# policy (its kernel predates SELinux inotify watch support), so the
# module would not compile there - and the kernel does not enforce the
# permission either, so the rule is simply omitted on RHEL 8.
ifndef(`distro_rhel8',`
    allow hostmetering_t cert_t:dir watch;
')

# subscription-manager attempts to rewrite /etc/dnf/plugins/
# subscription-manager.conf (labeled etc_t) on every invocation. The
# rewrite is idempotent housekeeping: the file content does not change,
# and the distro policy denies the same write to its own confined
# sub-man caller (rhsmcertd_t), so sub-man tolerates the failure.
# Granting write on generic etc_t files would be far too broad, so the
# denial is silenced instead to keep customer audit logs clean.
gen_require(`
    type etc_t;
')
dontaudit hostmetering_t etc_t:file write;

# subscription-manager helpers executed by the daemon traverse the
# insights-client configuration directory to read the insights
# machine-id. The insights_client_etc_t type does not exist in the RHEL 8
# base policy (no insights_client interface there), so the rule is
# required inside optional_policy and is dropped automatically on
# policies that do not define the type.
optional_policy(`
    gen_require(`
        type insights_client_etc_t;
    ')
    allow hostmetering_t insights_client_etc_t:dir search;
')

# subscription-manager helpers executed by the daemon use the cloud-what
# provider, whose cache lives in /var/cache/cloud-what. The type is
# declared in the distro rhsmcertd policy module, which grants its own
# domain manage access; mirror that (read-only would only reveal the
# next denial when the cache is refreshed). The rule is inside
# optional_policy so the module still builds where the type does not
# exist, mirroring how rhsmcertd.if exposes cloud_what_read_cache_files.
optional_policy(`
    gen_require(`
        type cloud_what_var_cache_t;
    ')
    files_search_var(hostmetering_t)
    manage_dirs_pattern(hostmetering_t, cloud_what_var_cache_t, cloud_what_var_cache_t)
    manage_files_pattern(hostmetering_t, cloud_what_var_cache_t, cloud_what_var_cache_t)
')

# Resolving the daemon cgroup membership on cgroup2 filesystems,
# including reading the CPU limit (cpu.max) of its own cgroup.
allow hostmetering_t cgroup_t:dir search;
allow hostmetering_t cgroup_t:file { getattr open read };
