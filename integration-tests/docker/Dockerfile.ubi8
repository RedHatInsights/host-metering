FROM registry.access.redhat.com/ubi8/ubi:latest

# Install Go, Python 3.9, pip, git, openssl, and system utilities
RUN dnf module enable -y python39 && \
    dnf install -y \
    golang \
    python39 \
    python39-pip \
    git \
    make \
    openssl \
    diffutils \
    procps-ng \
    && dnf clean all

# Upgrade pip and install Python dependencies for integration tests
COPY integration-tests/requirements.txt /tmp/requirements.txt
RUN pip3.9 install --no-cache-dir -r /tmp/requirements.txt && \
    ln -sf /usr/bin/python3.9 /usr/bin/python3 && \
    ln -sf /usr/local/bin/pytest /usr/bin/pytest || true

# Set up environment
ENV IS_IN_CONTAINER=true
ENV PATH=/workspace/host-metering/mocks:${PATH}

WORKDIR /workspace/host-metering
