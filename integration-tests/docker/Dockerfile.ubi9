FROM registry.access.redhat.com/ubi9/ubi:latest

# Install Go, Python3, pip, git, openssl, and system utilities
RUN dnf install -y \
    golang \
    python3 \
    python3-pip \
    git \
    make \
    openssl \
    diffutils \
    procps-ng \
    && dnf clean all

# Install pytest
RUN pip3 install pytest

# Set up environment
ENV IS_IN_CONTAINER=true
ENV PATH=/workspace/host-metering/mocks:${PATH}

WORKDIR /workspace/host-metering
