/main:
  summary: Host-metering VM integration tests
  description: |
      Performs full system-level testing of the host-metering daemon.
      Builds and installs the host-metering RPM package locally inside the VM
      to verify actual systemd and SELinux integration. Spawns an isolated
      Prometheus receiver container and executes the Pytest test suite.

      The guest is provisioned by the Testing Farm request; there is no
      local provision step in this plan.

  discover:
      how: fmf
      test:
        - /tests/integration

  prepare:
    - name: Install dependencies for building RPM and running tests
      how: install
      package:
        - golang
        - git
        - make
        - rpm-build
        - systemd-rpm-macros
        - selinux-policy-devel
        - policycoreutils
        - selinux-policy
        - tar
        - gzip
        - podman
        - curl
        - python3-pip
        - python3-devel
    - name: Install go-rpm-macros where available
      # Required for building the RPM on RHEL >= 9; not present in the
      # RHEL 8 repositories (the spec has a manual %gobuild fallback
      # there), so the install is best-effort.
      how: shell
      script: dnf -y install go-rpm-macros || true

  execute:
      how: tmt
